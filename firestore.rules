rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: skp_records
    // Fields:
    //   - nip: string (required)
    //   - namaPegawai: string (required)
    //   - authorUid: string (required, immutable)
    //   - status: string (required, enum: ["Belum Diambil", "Sudah Diambil"])
    //   - ... (other fields)
    //
    // Collection: plt_records, plh_records
    // Fields:
    //   - nip: string (required)
    //   - namaPegawai: string (required)
    //   - authorUid: string (required, immutable)
    //   - status: string (required, enum: ["Aktif", "Selesai"])
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(authorUid) {
      return isAuthenticated() && request.auth.uid == authorUid;
    }

    function isValidSKP(data) {
      return data.nip is string && data.nip.size() > 0 && data.nip.size() <= 20 &&
             data.namaPegawai is string && data.namaPegawai.size() > 0 && data.namaPegawai.size() <= 100 &&
             data.status in ["Belum Diambil", "Sudah Diambil"] &&
             data.authorUid == request.auth.uid;
    }

    function isValidPLT_PLH(data) {
      return data.nip is string && data.nip.size() > 0 && data.nip.size() <= 20 &&
             data.namaPegawai is string && data.namaPegawai.size() > 0 && data.namaPegawai.size() <= 100 &&
             data.status in ["Aktif", "Selesai"] &&
             data.authorUid == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /skp_records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidSKP(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin()) && 
                      isValidSKP(request.resource.data) &&
                      (request.resource.data.authorUid == resource.data.authorUid || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin());
    }

    match /plt_records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPLT_PLH(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin()) && 
                      isValidPLT_PLH(request.resource.data) &&
                      (request.resource.data.authorUid == resource.data.authorUid || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin());
    }

    match /plh_records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPLT_PLH(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin()) && 
                      isValidPLT_PLH(request.resource.data) &&
                      (request.resource.data.authorUid == resource.data.authorUid || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin());
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
