{
  "entities": {
    "SKPRecord": {
      "title": "SKP Record",
      "description": "Monitoring data for SKP (Sasaran Kinerja Pegawai)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nip": { "type": "string" },
        "namaPegawai": { "type": "string" },
        "jabatan": { "type": "string" },
        "unitKerja": { "type": "string" },
        "tahun": { "type": "number" },
        "periode": { "type": "string", "enum": ["Tahunan", "Triwulan I", "Triwulan II", "Triwulan III", "Triwulan IV"] },
        "jenisDokumen": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Belum Diambil", "Sudah Diambil"] },
        "ratingHasilKerja": { "type": "string" },
        "ratingHasilPerilaku": { "type": "string" },
        "predikatKinerja": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileName": { "type": "string" },
        "pengambil": { "type": "string" },
        "unitKerjaPengambil": { "type": "string" },
        "tanggalAmbil": { "type": "string", "format": "date-time" },
        "keterangan": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authorUid": { "type": "string" }
      },
      "required": ["nip", "namaPegawai", "jabatan", "unitKerja", "tahun", "periode", "status", "authorUid"]
    },
    "SKPMonitoringRecord": {
      "title": "SKP Monitoring Record",
      "description": "Assessment data for SKP (Sasaran Kinerja Pegawai) monitoring",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nip": { "type": "string" },
        "namaPegawai": { "type": "string" },
        "jabatan": { "type": "string" },
        "unitKerja": { "type": "string" },
        "tahun": { "type": "number" },
        "periode": { "type": "string", "enum": ["Tahunan", "Triwulan I", "Triwulan II", "Triwulan III", "Triwulan IV"] },
        "ratingHasilKerja": { "type": "string", "null": true },
        "ratingHasilPerilaku": { "type": "string", "null": true },
        "predikatKinerja": { "type": "string", "null": true },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authorUid": { "type": "string" }
      },
      "required": ["nip", "namaPegawai", "jabatan", "unitKerja", "tahun", "periode", "authorUid"]
    },
    "PLTRecord": {
      "title": "PLT Record",
      "description": "Monitoring data for PLT (Pelaksana Tugas)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nip": { "type": "string" },
        "namaPegawai": { "type": "string" },
        "jabatanAsli": { "type": "string" },
        "jabatanPlt": { "type": "string" },
        "unitKerja": { "type": "string" },
        "noSk": { "type": "string" },
        "tanggalSurat": { "type": "string", "format": "date" },
        "tmtMulai": { "type": "string" },
        "tmtSelesai": { "type": "string" },
        "status": { "type": "string", "enum": ["Aktif", "Selesai"] },
        "pegawaiDigantikan": { "type": "string" },
        "authorUid": { "type": "string" }
      },
      "required": ["nip", "namaPegawai", "jabatanPlt", "unitKerja", "status", "authorUid"]
    },
    "PLHRecord": {
      "title": "PLH Record",
      "description": "Monitoring data for PLH (Pelaksana Harian)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nip": { "type": "string" },
        "namaPegawai": { "type": "string" },
        "jabatanAsli": { "type": "string" },
        "jabatanPlh": { "type": "string" },
        "unitKerja": { "type": "string" },
        "noSk": { "type": "string" },
        "tanggalSurat": { "type": "string", "format": "date" },
        "tmtMulai": { "type": "string" },
        "tmtSelesai": { "type": "string" },
        "status": { "type": "string", "enum": ["Aktif", "Selesai"] },
        "pegawaiDigantikan": { "type": "string" },
        "authorUid": { "type": "string" }
      },
      "required": ["nip", "namaPegawai", "jabatanPlh", "unitKerja", "status", "authorUid"]
    },
    "WorkTeam": {
      "title": "Work Team",
      "description": "Monitoring data for Work Teams",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "namaTim": { "type": "string" },
        "unitKerja": { "type": "string" },
        "tahun": { "type": "number" },
        "status": { "type": "string", "enum": ["Aktif", "Non-Aktif"] },
        "jenis": { "type": "string", "enum": ["Tim Kerja", "Bagian"] },
        "parentId": { "type": "string" },
        "authorUid": { "type": "string" },
        "ketua": {
          "type": "object",
          "properties": {
            "nama": { "type": "string" },
            "jabatan": { "type": "string" },
            "status": { "type": "string", "enum": ["PNS", "CPNS", "PPPK", "PPPK Paruh Waktu"] }
          }
        },
        "anggota": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nama": { "type": "string" },
              "jabatan": { "type": "string" },
              "status": { "type": "string", "enum": ["PNS", "CPNS", "PPPK", "PPPK Paruh Waktu"] }
            }
          }
        }
      },
      "required": ["namaTim", "unitKerja", "tahun", "status", "authorUid", "ketua"]
    },
    "OrgNode": {
      "title": "Organization Node",
      "description": "Formal organizational structure node",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "namaJabatan": { "type": "string" },
        "namaPegawai": { "type": "string" },
        "nip": { "type": "string" },
        "parentId": { "type": "string" },
        "order": { "type": "number" },
        "authorUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["namaJabatan", "namaPegawai", "authorUid"]
    },
    "UnitInfo": {
      "title": "Unit Info",
      "description": "SK information for a Unit Kerja",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unitKerja": { "type": "string" },
        "nomorSK": { "type": "string" },
        "tanggalSK": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authorUid": { "type": "string" }
      },
      "required": ["unitKerja", "authorUid"]
    },
    "OfficialHistoryRecord": {
      "title": "Official History Record",
      "description": "Historical leadership records for a Unit Kerja",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unitKerja": { "type": "string" },
        "namaPejabat": { "type": "string" },
        "nip": { "type": "string" },
        "jabatan": { "type": "string" },
        "tmtMulai": { "type": "string" },
        "tmtSelesai": { "type": "string" },
        "isCurrent": { "type": "boolean" },
        "keterangan": { "type": "string" },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["unitKerja", "namaPejabat", "jabatan", "tmtMulai", "isCurrent", "authorUid"]
    }
  },
  "firestore": {
    "/skp_records/{recordId}": {
      "schema": "SKPRecord",
      "description": "Collection of SKP monitoring records"
    },
    "/skp_monitoring_records/{recordId}": {
      "schema": "SKPMonitoringRecord",
      "description": "Collection of SKP monitoring assessments"
    },
    "/plt_records/{recordId}": {
      "schema": "PLTRecord",
      "description": "Collection of PLT monitoring records"
    },
    "/plh_records/{recordId}": {
      "schema": "PLHRecord",
      "description": "Collection of PLH monitoring records"
    },
    "/work_teams/{teamId}": {
      "schema": "WorkTeam",
      "description": "Collection of Work Team monitoring records"
    },
    "/unit_info/{unitId}": {
      "schema": "UnitInfo",
      "description": "Collection of SK information for Unit Kerja"
    },
    "/org_structure/{nodeId}": {
      "schema": "OrgNode",
      "description": "Collection of formal organizational structure nodes"
    },
    "/official_history/{historyId}": {
      "schema": "OfficialHistoryRecord",
      "description": "Collection of official leadership history per unit kerja"
    }
  }
}
